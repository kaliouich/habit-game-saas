# Copier vers secrets.local.yaml (gitignored — jamais commité) si tu veux que
# Helm CRÉE le Secret lui-même (secrets.create: true). En prod actuelle, le
# Secret habit-game-secrets existe déjà en cluster (créé manuellement) donc
# secrets.create reste false et ce fichier n'est pas nécessaire.
#
# Usage:
#   helm upgrade --install habit-game ./helm/habit-game \
#     -f helm/habit-game/values-production.yaml \
#     -f helm/habit-game/secrets.local.yaml

secrets:
  create: true
  postgresPassword: "CHANGE_ME"
  databaseUrl: "postgresql://habit:CHANGE_ME@habit-postgres:5432/habitgame"
  cronSecret: "CHANGE_ME"          # openssl rand -base64 32
  authSecret: "CHANGE_ME"          # openssl rand -base64 32
  authUrl: "https://habitcade.com"
  authGoogleId: ""
  authGoogleSecret: ""
  authResendKey: ""
  emailFrom: "Habit Game <noreply@khalilaliouich.com>"
  stripeSecretKey: ""
  stripePublishableKey: ""
  stripeWebhookSecret: ""
  stripePricePro: ""
