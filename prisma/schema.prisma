generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Utilisateur & plan ────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  image            String?
  emailVerified    DateTime?
  // Billing
  stripeCustomerId String?   @unique
  plan             Plan      @default(FREE)
  planStatus       String?
  trialEndsAt      DateTime?
  // Préférences
  theme            String    @default("light")
  weekStartsOn     Int       @default(1)
  timezone         String    @default("Africa/Tunis")
  // Parrainage (B-referral) — code généré paresseusement dans lib/user.ts
  // (l'adapter Auth.js crée les users sans ce champ, donc pas de défaut requis en base)
  referralCode         String?  @unique
  referredById         String?
  referredBy           User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]   @relation("Referrals")
  referralCreditMonths Int      @default(0) // mois gratuits accumulés grâce à ses filleuls, consommés au prochain checkout
  referralCredited     Boolean  @default(false) // ce user (en tant que filleul) a-t-il déjà déclenché le crédit de son parrain ?
  habits           Habit[]
  moods            MoodLog[]
  accounts         Account[]
  sessions         Session[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── Habitudes & logs ─────────────────────────────────────────────────────────

enum HabitType {
  BUILD
  QUIT
}

model Habit {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  emoji      String?
  type       HabitType  @default(BUILD)
  goal       Int?
  position   Int        @default(0)
  archivedAt DateTime?
  logs       HabitLog[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, archivedAt])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD" dans le fuseau du user
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId, date])
}

model MoodLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"
  value  Int // 1..5

  @@unique([userId, date])
}

// ─── Stripe ───────────────────────────────────────────────────────────────────

model StripeEvent {
  id        String   @id // event.id Stripe — garantit l'idempotence du webhook
  type      String
  createdAt DateTime @default(now())
}

// ─── Auth.js v5 (adapter Prisma) ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
