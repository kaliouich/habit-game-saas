generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Utilisateur & plan ────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  image            String?
  emailVerified    DateTime?
  // Billing
  stripeCustomerId String?   @unique
  plan             Plan      @default(FREE)
  planStatus       String?
  trialEndsAt      DateTime?
  // Préférences
  theme            String    @default("light")
  weekStartsOn     Int       @default(1)
  timezone         String    @default("Africa/Tunis")
  boardSkin        String    @default("classic") // cosmétique — voir BOARD_SKINS (config.ts), tiers pro appliqués côté serveur
  // Parrainage (B-referral) — code généré paresseusement dans lib/user.ts
  // (l'adapter Auth.js crée les users sans ce champ, donc pas de défaut requis en base)
  referralCode         String?  @unique
  referredById         String?
  referredBy           User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]   @relation("Referrals")
  referralCreditMonths Int      @default(0) // mois gratuits accumulés grâce à ses filleuls, consommés au prochain checkout
  referralCredited     Boolean  @default(false) // ce user (en tant que filleul) a-t-il déjà déclenché le crédit de son parrain ?
  habits           Habit[]
  moods            MoodLog[]
  shields          StreakShield[]
  accounts         Account[]
  sessions         Session[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── Habitudes & logs ─────────────────────────────────────────────────────────

enum HabitType {
  BUILD
  QUIT
}

model Habit {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  emoji      String?
  type       HabitType    @default(BUILD)
  goal       Int?
  position   Int          @default(0)
  tags       String[]     @default([]) // libre, pro-only côté UI (voir actions/habits.ts)
  archivedAt DateTime?
  logs       HabitLog[]
  pauses     HabitPause[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, archivedAt])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD" dans le fuseau du user
  completed Boolean  @default(true)
  note      String? // pro-only côté UI, max 280 caractères (zod)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId, date])
}

/// Pause / vacation mode (Pro) : les jours dans [from, to] n'entrent ni ne
/// cassent un streak (voir currentStreak/bestStreak dans lib/stats.ts).
model HabitPause {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  from    String // "YYYY-MM-DD"
  to      String // "YYYY-MM-DD", inclusif

  @@index([habitId])
}

/// Streak Shield (Sprint 7) : un jour manqué absorbé pour TOUTES les habitudes
/// — même traitement qu'une pause côté calcul de série (voir lib/stats.ts),
/// donc aucun changement d'algorithme. Quota mensuel selon le plan
/// (SHIELDS_PER_MONTH, config.ts), consommé a posteriori sur un jour passé.
model StreakShield {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD" — le jour couvert
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model MoodLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"
  value  Int // 1..5

  @@unique([userId, date])
}

// ─── Stripe ───────────────────────────────────────────────────────────────────

model StripeEvent {
  id        String   @id // event.id Stripe — garantit l'idempotence du webhook
  type      String
  createdAt DateTime @default(now())
}

// ─── Auth.js v5 (adapter Prisma) ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
