# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://habit:habit_dev_pw@localhost:5432/habitgame

# ── Auth.js v5 (Sprint 3) ────────────────────────────────────────────────────
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=${NEXT_PUBLIC_APP_URL}
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM="Habit Game <no-reply@example.com>"

# ── Stripe (Sprint 3) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Gamification & récap (Sprint 5) ─────────────────────────────────────────
# Secret partagé avec le CronJob k8s (k8s/weekly-recap-cronjob.yaml) pour
# déclencher /api/cron/weekly-recap. Sans clé Resend (ci-dessus), l'envoi est
# un no-op propre (log), la route reste sans danger à appeler.
CRON_SECRET=            # openssl rand -base64 32

# ── Monitoring (Sprint 4) ────────────────────────────────────────────────────
# Sentry : non intégré (SDK + upload sourcemaps nécessitent DSN + org + projet
# réels pour être testés sans risquer de casser le build). À ajouter quand
# le compte Sentry existe — voir PLAN.md §Sprint 4.
SENTRY_DSN=
# Umami (analytics self-hosted, cookie-free) — les deux valeurs doivent être
# renseignées ensemble, sinon le script n'est pas injecté (no-op).
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_ID=
